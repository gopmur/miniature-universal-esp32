menu "Tasks"

menu "DNS"

config HEXA_TASKS_DNS_PRIORITY
  int "Priority"
  default 18

config HEXA_TASKS_DNS_STACK_SIZE
  int "Stack Size"
  default 4096

config HEXA_TASKS_DNS_NAME_SIZE
  string "Domain Name"
  default "hexa.lan"

endmenu

