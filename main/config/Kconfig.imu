menu "IMU"

config HEXA_IMU_SDA_PIN
  int "SDA pin"
  default 21

config HEXA_IMU_SCL_PIN
  int "SCL pin"
  default 22

choice HEXA_IMU_TYPE
  prompt "type"
  default HEXA_IMU_TYPE_I2C_ICM20948
  help
    Select IMU type

config HEXA_IMU_TYPE_I2C_ICM20948
  bool "icm20948"

config HEXA_IMU_TYPE_MOCK
  bool "mock"

endchoice

config HEXA_IMU_I2C_ICM20948_AD1
  bool "AD1"
  default n
  depends on HEXA_IMU_TYPE_I2C_ICM20948

endmenu