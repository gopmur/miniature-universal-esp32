menu "Motors"

config HEXA_MOTOR_POWER_ENABLE_PIN
  int "Power enable pin"
  help
    GPIO pin of the motors power switch

config HEXA_MOTOR_TIMEOUT_MS
  int "Timeout delay ms"
  default 50
  help 
    Maximum time in milliseconds to wait for a motor response after
    sending a command before marking the motor as disconnected.

config HEXA_MOTOR_COUNT
  int "Number of motors"
  range 1 8
  default 8
  help
    Number of motors in use of the robot

menu "Motor 0"
  depends on HEXA_MOTOR_COUNT >= 1

config HEXA_MOTOR_0_CAN_INTERFACE
  int "CAN interface"
  range 0 1 if HEXA_CAN_COUNT = 2
  range 0 0 if HEXA_CAN_COUNT = 1
  default 0
  help
    The can interface which the motor is connected to

config HEXA_MOTOR_0_ID
  hex "CAN ID"
  range 0x0 0x7FF
  default 0x0
  help
    Unique CAN ID of the motor

choice HEXA_MOTOR_0_TYPE
  prompt "Type"
  default HEXA_MOTOR_0_TYPE_ODRIVE
  help
      Select motor type.

config HEXA_MOTOR_0_TYPE_ODRIVE
  bool "ODrive"

config HEXA_MOTOR_0_TYPE_SMC
  bool "SMC"

config HEXA_MOTOR_0_TYPE_T_MOTOR
  bool "T-Motor"

endchoice

config HEXA_MOTOR_0_RECEIVE_ID
  hex "Receive ID" if HEXA_MOTOR_0_TYPE_T_MOTOR
  range 0x0 0x7FF
  default 0x0
  help
    The CAN ID which the motor uses to send feedbacks

config HEXA_MOTOR_0_BACKWARDS
  bool "Is backwards"
  default n
  help
    If enabled all feedbacks and commands are multiplied by -1

endmenu

