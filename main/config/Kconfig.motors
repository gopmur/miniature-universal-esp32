menu "Motors"

config HEXA_MOTOR_POWER_ENABLE_PIN
  int "Power enable pin"

config HEXA_MOTOR_TIMEOUT_MS
  int "Timeout delay ms"
  default 50

config HEXA_MOTOR_COUNT
  int "Number of motors"
  range 1 8
  default 8

menu "Motor 0"
  depends on HEXA_MOTOR_COUNT >= 1

config HEXA_MOTOR_0_ID
  hex "ID"
  range 0x0 0x7FF
  default 0x0

choice HEXA_MOTOR_0_TYPE
  prompt "Type"
  default HEXA_MOTOR_0_TYPE_ODRIVE
  help
      Select motor type.

config HEXA_MOTOR_0_TYPE_ODRIVE
  bool "ODrive"

config HEXA_MOTOR_0_TYPE_SMC
  bool "SMC"

config HEXA_MOTOR_0_TYPE_T_MOTOR
  bool "T-Motor"

endchoice

config HEXA_MOTOR_0_RECEIVE_ID
  hex "Receive ID" if HEXA_MOTOR_0_TYPE_T_MOTOR
  range 0x0 0x7FF
  default 0x0

config HEXA_MOTOR_0_BACKWARDS
  bool "Is backwards"
  default false

endmenu

menu "Motor 1"
  depends on HEXA_MOTOR_COUNT >= 2

config HEXA_MOTOR_1_ID
  hex "ID"
  range 0x0 0x7FF
  default 0x0

choice HEXA_MOTOR_1_TYPE
  prompt "Type"
  default HEXA_MOTOR_1_TYPE_ODRIVE
  help
      Select motor type.

config HEXA_MOTOR_1_TYPE_ODRIVE
  bool "ODrive"

config HEXA_MOTOR_1_TYPE_SMC
  bool "SMC"

config HEXA_MOTOR_1_TYPE_T_MOTOR
  bool "T-Motor"

  
endchoice

config HEXA_MOTOR_1_RECEIVE_ID
  hex "Receive ID" if HEXA_MOTOR_1_TYPE_T_MOTOR
  range 0x0 0x7FF
  default 0x0

config HEXA_MOTOR_1_BACKWARDS
  bool "Is backwards"
  default false
endmenu

