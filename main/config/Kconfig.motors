menu "Motors"

config HEXA_MOTOR_POWER_ENABLE_PIN
  int "Power enable pin"

config HEXA_MOTOR_TIMEOUT_MS
  int "Timeout delay ms"
  default 50

config HEXA_MOTOR_COUNT
  int "Number of motors"
  range 1 8
  default 8

menu "Motor 0"
  depends on HEXA_MOTOR_COUNT >= 1

config HEXA_MOTOR_0_ID
  int "ID"
  range 0 2047
  default 0
  depends on !HEXA_MOTOR_0_DISABLED

choice HEXA_MOTOR_0_TYPE
  prompt "Type"
  default HEXA_MOTOR_0_DISABLED
  help
      Select motor type.

config HEXA_MOTOR_0_TYPE_ODRIVE
  bool "ODrive"

config HEXA_MOTOR_0_TYPE_SMC
  bool "SMC"

config HEXA_MOTOR_0_TYPE_T_MOTOR
  bool "T-Motor"

config HEXA_MOTOR_0_DISABLED
  bool "Disable"

endchoice

endmenu

menu "Motor 1"
  depends on HEXA_MOTOR_COUNT >= 2

config HEXA_MOTOR_1_ID
  int "ID"
  range 0 2047
  default 1
  depends on !HEXA_MOTOR_1_DISABLED

choice HEXA_MOTOR_1_TYPE
  prompt "Type"
  default HEXA_MOTOR_1_DISABLED
  help
      Select motor type.

config HEXA_MOTOR_1_TYPE_ODRIVE
  bool "ODrive"

config HEXA_MOTOR_1_TYPE_SMC
  bool "SMC"

config HEXA_MOTOR_1_TYPE_T_MOTOR
  bool "T-Motor"

config HEXA_MOTOR_1_DISABLED
  bool "Disable"
  

endchoice

endmenu

